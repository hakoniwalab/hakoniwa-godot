{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HAKONIWA_GODOT_BUILD_TESTS": "ON",
        "HAKONIWA_GODOT_MINIMAL_DEP_BUILD": "ON",
        "HAKONIWA_GODOT_CODEC_PACKAGES": "hako_msgs"
      }
    },
    {
      "name": "all-codecs",
      "displayName": "All Codecs",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-all-codecs",
      "cacheVariables": {
        "HAKONIWA_GODOT_CODEC_PACKAGES": "all"
      }
    },
    {
      "name": "common-codecs",
      "displayName": "Common Codecs",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-common-codecs",
      "cacheVariables": {
        "HAKONIWA_GODOT_CODEC_PACKAGES": "hako_msgs;std_msgs;geometry_msgs;sensor_msgs"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows Default",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-win-default",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "HAKONIWA_GODOT_BUILD_TESTS": "ON",
        "HAKONIWA_GODOT_MINIMAL_DEP_BUILD": "ON",
        "HAKONIWA_GODOT_CODEC_PACKAGES": "hako_msgs"
      }
    },
    {
      "name": "windows-all-codecs",
      "displayName": "Windows All Codecs",
      "inherits": "windows-default",
      "binaryDir": "${sourceDir}/build-win-all-codecs",
      "cacheVariables": {
        "HAKONIWA_GODOT_CODEC_PACKAGES": "all"
      }
    },
    {
      "name": "windows-common-codecs",
      "displayName": "Windows Common Codecs",
      "inherits": "windows-default",
      "binaryDir": "${sourceDir}/build-win-common-codecs",
      "cacheVariables": {
        "HAKONIWA_GODOT_CODEC_PACKAGES": "hako_msgs;std_msgs;geometry_msgs;sensor_msgs"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 4
    },
    {
      "name": "all-codecs",
      "configurePreset": "all-codecs",
      "jobs": 4
    },
    {
      "name": "common-codecs",
      "configurePreset": "common-codecs",
      "jobs": 4
    },
    {
      "name": "windows-default-debug",
      "configurePreset": "windows-default",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-default-release",
      "configurePreset": "windows-default",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-all-codecs-debug",
      "configurePreset": "windows-all-codecs",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-all-codecs-release",
      "configurePreset": "windows-all-codecs",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-common-codecs-debug",
      "configurePreset": "windows-common-codecs",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-common-codecs-release",
      "configurePreset": "windows-common-codecs",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "common-codecs",
      "configurePreset": "common-codecs",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
